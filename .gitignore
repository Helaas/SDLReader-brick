# MuPDF build directories (downloaded and built dynamically)
/ports/*/mupdf/
/ports/*/libarchive*
/ports/*/*webp*

# TG5040 bundle artifacts (legacy - for individual builds)
/ports/tg5040/pak/lib/*
/ports/tg5040/pak/fonts/*
/ports/tg5040/pak/res/*
!/ports/tg5040/pak/res/docs.pdf
/ports/tg5040/pak/bin/sdl_reader_cli

# TG5050 bundle artifacts (legacy - for individual builds)
/ports/tg5050/pak/lib/*
/ports/tg5050/pak/fonts/*
/ports/tg5050/pak/res/*
!/ports/tg5050/pak/res/docs.pdf
/ports/tg5050/pak/bin/sdl_reader_cli

# MY355 bundle artifacts (legacy - for individual builds)
/ports/my355/pak/lib/*
/ports/my355/pak/fonts/*
/ports/my355/pak/res/*
!/ports/my355/pak/res/docs.pdf
/ports/my355/pak/bin/sdl_reader_cli

# MLP1 bundle artifacts
/ports/mlp1/pak/lib/*
/ports/mlp1/pak/fonts/*
/ports/mlp1/pak/res/*
!/ports/mlp1/pak/res/docs.pdf
/ports/mlp1/pak/bin/sdl_reader_cli

# Unified TrimUI bundle staging (generated by export_bundle.sh)
/ports/trimui/staging/

